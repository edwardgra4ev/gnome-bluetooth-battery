msgid "Battery low, connect a charger"
msgstr "Заряд низкий, подключите зарядку"

msgid "No connected Bluetooth devices with a battery"
msgstr "Нет подключённых Bluetooth-устройств с данными о заряде"

msgid "Settings"
msgstr "Настройки"

msgid "Panel position"
msgstr "Расположение панели"

msgid "GNOME Shell cannot reorder panel items by dragging. Pick a section and an order instead."
msgstr "GNOME Shell не умеет перетаскивать элементы панели. Выберите блок и порядок вручную."

msgid "Section"
msgstr "Блок"

msgid "Right"
msgstr "Справа"

msgid "Center"
msgstr "По центру"

msgid "Left"
msgstr "Слева"

msgid "Order"
msgstr "Порядок"

msgid "0 = first item in the section, higher values move it right"
msgstr "0 — первый элемент в блоке, больше значение — правее"

msgid "Low battery notifications"
msgstr "Уведомления о низком заряде"

msgid "Battery percentages that trigger a system notification, separated by commas. Leave the field empty to disable the notifications."
msgstr "Проценты заряда, при которых приходит системное уведомление, через запятую. Пустое поле выключает уведомления."

msgid "Thresholds (%)"
msgstr "Пороги (%)"

msgid "Devices"
msgstr "Устройства"

msgid "Uncheck a device to hide it from the panel. Hidden devices do not send low battery notifications either."
msgstr "Снимите галочку, чтобы скрыть устройство из панели. Скрытые устройства не присылают уведомления о низком заряде."

msgid "No paired Bluetooth devices found."
msgstr "Сопряжённые Bluetooth-устройства не найдены."
